.nh
.TH "GUMROAD" "1" "Sep 2026" "Gumroad" "Gumroad CLI"

.SH NAME
gumroad-admin-users-affiliates - List affiliate relationships for a user


.SH SYNOPSIS
\fBgumroad admin users affiliates [flags]\fP


.SH DESCRIPTION
List affiliate relationships for a user in one direction. Use
--direction granted when the user is the seller granting affiliate access, or
--direction received when the user is the affiliate receiving access.


.SH OPTIONS
\fB--cursor\fP=""
	Pagination cursor (from a previous response)

.PP
\fB--direction\fP=""
	Affiliate direction: granted or received (required)

.PP
\fB--email\fP=""
	User email

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for affiliates

.PP
\fB--limit\fP=0
	Maximum results to return (default 20, capped at 100)

.PP
\fB--user-id\fP=""
	User external ID

.PP
\fB--username\fP=""
	User username


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--debug\fP[=false]
	Enable debug logging to stderr

.PP
\fB--dry-run\fP[=false]
	Preview mutating requests without executing them

.PP
\fB--jq\fP=""
	Filter JSON output with a jq expression

.PP
\fB--json\fP[=false]
	Output as JSON

.PP
\fB--no-color\fP[=false]
	Disable color output

.PP
\fB--no-image\fP[=false]
	Disable image rendering

.PP
\fB--no-input\fP[=false]
	Disable interactive prompts

.PP
\fB--non-interactive\fP[=false]
	Run in explicit CI/agent mode

.PP
\fB--page-delay\fP=0s
	Wait between paginated --all requests (e.g. 200ms, 1s)

.PP
\fB--plain\fP[=false]
	Output as plain tab-separated text

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-essential output

.PP
\fB--yes\fP[=false]
	Skip confirmation prompts


.SH EXAMPLE
.EX
  gumroad admin users affiliates --user-id 2245593582708 --direction granted
  gumroad admin users affiliates --username sellerone --direction granted
  gumroad admin users affiliates --email user@example.com --direction received --limit 50
  gumroad admin users affiliates --email user@example.com --direction received --cursor cur-next
.EE


.SH SEE ALSO
\fBgumroad-admin-users(1)\fP
