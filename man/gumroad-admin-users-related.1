.nh
.TH "GUMROAD" "1" "Sep 2026" "Gumroad" "Gumroad CLI"

.SH NAME
gumroad-admin-users-related - Find users related by shared risk signals


.SH SYNOPSIS
\fBgumroad admin users related [flags]\fP


.SH DESCRIPTION
Find users related by shared IP address, payment address, or card
fingerprint. By default the server evaluates all available signals; repeat
--signal to restrict the search to one or more signals.


.SH OPTIONS
\fB--email\fP=""
	User email

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for related

.PP
\fB--limit\fP=0
	Maximum related users per signal (default 50, capped server-side at 50)

.PP
\fB--signal\fP=[]
	Related signal to evaluate: ip, payment_address, card_fingerprint (repeatable)

.PP
\fB--user-id\fP=""
	User external ID

.PP
\fB--username\fP=""
	User username


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--debug\fP[=false]
	Enable debug logging to stderr

.PP
\fB--dry-run\fP[=false]
	Preview mutating requests without executing them

.PP
\fB--jq\fP=""
	Filter JSON output with a jq expression

.PP
\fB--json\fP[=false]
	Output as JSON

.PP
\fB--no-color\fP[=false]
	Disable color output

.PP
\fB--no-image\fP[=false]
	Disable image rendering

.PP
\fB--no-input\fP[=false]
	Disable interactive prompts

.PP
\fB--non-interactive\fP[=false]
	Run in explicit CI/agent mode

.PP
\fB--page-delay\fP=0s
	Wait between paginated --all requests (e.g. 200ms, 1s)

.PP
\fB--plain\fP[=false]
	Output as plain tab-separated text

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-essential output

.PP
\fB--yes\fP[=false]
	Skip confirmation prompts


.SH EXAMPLE
.EX
  gumroad admin users related --user-id 2245593582708
  gumroad admin users related --username sellerone --signal ip
  gumroad admin users related --email user@example.com --signal ip --signal payment_address
  gumroad admin users related --email user@example.com --limit 25 --json
.EE


.SH SEE ALSO
\fBgumroad-admin-users(1)\fP
