.nh
.TH "GUMROAD" "1" "Sep 2026" "Gumroad" "Gumroad CLI"

.SH NAME
gumroad-admin-users-credits-list - List credits for a user


.SH SYNOPSIS
\fBgumroad admin users credits list [flags]\fP


.SH DESCRIPTION
List a user's account credits, newest first.


.SH OPTIONS
\fB--cursor\fP=""
	Pagination cursor (from a previous response)

.PP
\fB--email\fP=""
	User email

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for list

.PP
\fB--limit\fP=0
	Maximum results per page (default 20)

.PP
\fB--user-id\fP=""
	User external ID

.PP
\fB--username\fP=""
	User username


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--debug\fP[=false]
	Enable debug logging to stderr

.PP
\fB--dry-run\fP[=false]
	Preview mutating requests without executing them

.PP
\fB--jq\fP=""
	Filter JSON output with a jq expression

.PP
\fB--json\fP[=false]
	Output as JSON

.PP
\fB--no-color\fP[=false]
	Disable color output

.PP
\fB--no-image\fP[=false]
	Disable image rendering

.PP
\fB--no-input\fP[=false]
	Disable interactive prompts

.PP
\fB--non-interactive\fP[=false]
	Run in explicit CI/agent mode

.PP
\fB--page-delay\fP=0s
	Wait between paginated --all requests (e.g. 200ms, 1s)

.PP
\fB--plain\fP[=false]
	Output as plain tab-separated text

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-essential output

.PP
\fB--yes\fP[=false]
	Skip confirmation prompts


.SH EXAMPLE
.EX
  gumroad admin users credits list --user-id 2245593582708
  gumroad admin users credits list --username sellerone
  gumroad admin users credits list --email seller@example.com --limit 50
  gumroad admin users credits list --user-id 2245593582708 --cursor cur-next
.EE


.SH SEE ALSO
\fBgumroad-admin-users-credits(1)\fP
