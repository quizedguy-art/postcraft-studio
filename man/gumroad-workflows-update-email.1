.nh
.TH "GUMROAD" "1" "Sep 2026" "Gumroad" "Gumroad CLI"

.SH NAME
gumroad-workflows-update-email - Update an email step in a workflow


.SH SYNOPSIS
\fBgumroad workflows update-email   [flags]\fP


.SH DESCRIPTION
Update selected fields on one workflow email step.

.PP
Omitted fields stay unchanged. This command does not change the workflow
publication state. A delay change can reschedule recipients and requires
confirmation.


.SH OPTIONS
\fB--body\fP=""
	Path to a new HTML body file, or - for stdin

.PP
\fB--delay\fP=""
	New delay such as "4 weeks"

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for update-email

.PP
\fB--subject\fP=""
	New email subject


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--debug\fP[=false]
	Enable debug logging to stderr

.PP
\fB--dry-run\fP[=false]
	Preview mutating requests without executing them

.PP
\fB--jq\fP=""
	Filter JSON output with a jq expression

.PP
\fB--json\fP[=false]
	Output as JSON

.PP
\fB--no-color\fP[=false]
	Disable color output

.PP
\fB--no-image\fP[=false]
	Disable image rendering

.PP
\fB--no-input\fP[=false]
	Disable interactive prompts

.PP
\fB--non-interactive\fP[=false]
	Run in explicit CI/agent mode

.PP
\fB--page-delay\fP=0s
	Wait between paginated --all requests (e.g. 200ms, 1s)

.PP
\fB--plain\fP[=false]
	Output as plain tab-separated text

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-essential output

.PP
\fB--yes\fP[=false]
	Skip confirmation prompts


.SH EXAMPLE
.EX
  gumroad workflows update-email <workflow-id> <email-id> --body ./email.html
  gumroad workflows update-email <workflow-id> <email-id> --subject "New subject" --delay "2 days" --yes
  build-email | gumroad workflows update-email <workflow-id> <email-id> --body -
  gumroad workflows update-email <workflow-id> <email-id> --delay "1 week" --dry-run
.EE


.SH SEE ALSO
\fBgumroad-workflows(1)\fP
