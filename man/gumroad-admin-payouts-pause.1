.nh
.TH "GUMROAD" "1" "Sep 2026" "Gumroad" "Gumroad CLI"

.SH NAME
gumroad-admin-payouts-pause - Pause payouts for a user as an admin


.SH SYNOPSIS
\fBgumroad admin payouts pause [flags]\fP


.SH DESCRIPTION
Pause internal payouts for a user. Pass --reason to record an audit comment
on the user explaining why payouts were paused; the comment is omitted when no
reason is provided.


.SH OPTIONS
\fB--expected-email\fP=""
	Optional current email guard

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for pause

.PP
\fB--reason\fP=""
	Audit comment recorded against the user

.PP
\fB--user-id\fP=""
	User external ID (required)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--debug\fP[=false]
	Enable debug logging to stderr

.PP
\fB--dry-run\fP[=false]
	Preview mutating requests without executing them

.PP
\fB--jq\fP=""
	Filter JSON output with a jq expression

.PP
\fB--json\fP[=false]
	Output as JSON

.PP
\fB--no-color\fP[=false]
	Disable color output

.PP
\fB--no-image\fP[=false]
	Disable image rendering

.PP
\fB--no-input\fP[=false]
	Disable interactive prompts

.PP
\fB--non-interactive\fP[=false]
	Run in explicit CI/agent mode

.PP
\fB--page-delay\fP=0s
	Wait between paginated --all requests (e.g. 200ms, 1s)

.PP
\fB--plain\fP[=false]
	Output as plain tab-separated text

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-essential output

.PP
\fB--yes\fP[=false]
	Skip confirmation prompts


.SH EXAMPLE
.EX
  gumroad admin payouts pause --user-id 2245593582708
  gumroad admin payouts pause --user-id 2245593582708 --expected-email seller@example.com --reason "Verification pending"
  gumroad admin payouts pause --user-id 2245593582708 --yes
.EE


.SH SEE ALSO
\fBgumroad-admin-payouts(1)\fP
