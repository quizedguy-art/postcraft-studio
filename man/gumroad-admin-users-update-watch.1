.nh
.TH "GUMROAD" "1" "Sep 2026" "Gumroad" "Gumroad CLI"

.SH NAME
gumroad-admin-users-update-watch - Update a user's active watchlist entry


.SH SYNOPSIS
\fBgumroad admin users update-watch [flags]\fP


.SH DESCRIPTION
Update the active watchlist entry for a user. When --note is omitted, the
existing note is preserved. Use --clear-note to remove the existing note.


.SH OPTIONS
\fB--clear-note\fP[=false]
	Clear the existing watch note

.PP
\fB--expected-email\fP=""
	Optional current email guard

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for update-watch

.PP
\fB--note\fP=""
	Watch note

.PP
\fB--revenue-threshold\fP=""
	Revenue threshold as a money amount, for example 500 or 500.00 (required)

.PP
\fB--user-id\fP=""
	User external ID (required)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--debug\fP[=false]
	Enable debug logging to stderr

.PP
\fB--dry-run\fP[=false]
	Preview mutating requests without executing them

.PP
\fB--jq\fP=""
	Filter JSON output with a jq expression

.PP
\fB--json\fP[=false]
	Output as JSON

.PP
\fB--no-color\fP[=false]
	Disable color output

.PP
\fB--no-image\fP[=false]
	Disable image rendering

.PP
\fB--no-input\fP[=false]
	Disable interactive prompts

.PP
\fB--non-interactive\fP[=false]
	Run in explicit CI/agent mode

.PP
\fB--page-delay\fP=0s
	Wait between paginated --all requests (e.g. 200ms, 1s)

.PP
\fB--plain\fP[=false]
	Output as plain tab-separated text

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-essential output

.PP
\fB--yes\fP[=false]
	Skip confirmation prompts


.SH EXAMPLE
.EX
  gumroad admin users update-watch --user-id 2245593582708 --revenue-threshold 500
  gumroad admin users update-watch --user-id 2245593582708 --revenue-threshold 500 --note "Still monitoring"
  gumroad admin users update-watch --user-id 2245593582708 --revenue-threshold 500 --clear-note
.EE


.SH SEE ALSO
\fBgumroad-admin-users(1)\fP
