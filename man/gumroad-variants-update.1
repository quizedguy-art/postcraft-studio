.nh
.TH "GUMROAD" "1" "Sep 2026" "Gumroad" "Gumroad CLI"

.SH NAME
gumroad-variants-update - Update a variant


.SH SYNOPSIS
\fBgumroad variants update  [flags]\fP


.SH DESCRIPTION
Update a variant


.SH OPTIONS
\fB--category\fP=""
	Variant category ID (required)

.PP
\fB--description\fP=""
	New description

.PP
\fB--file\fP=[]
	Add a local file to this variant's content without replacing existing embeds (repeatable)

.PP
\fB--file-description\fP=[]
	Description for the matching --file (repeatable)

.PP
\fB--file-name\fP=[]
	Display name for the matching --file (repeatable)

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for update

.PP
\fB--max-purchase-count\fP=0
	New max purchase count

.PP
\fB--name\fP=""
	New name

.PP
\fB--price-difference\fP=""
	New price difference (e.g. 5.00, -1.50)

.PP
\fB--product\fP=""
	Product ID (required)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--debug\fP[=false]
	Enable debug logging to stderr

.PP
\fB--dry-run\fP[=false]
	Preview mutating requests without executing them

.PP
\fB--jq\fP=""
	Filter JSON output with a jq expression

.PP
\fB--json\fP[=false]
	Output as JSON

.PP
\fB--no-color\fP[=false]
	Disable color output

.PP
\fB--no-image\fP[=false]
	Disable image rendering

.PP
\fB--no-input\fP[=false]
	Disable interactive prompts

.PP
\fB--non-interactive\fP[=false]
	Run in explicit CI/agent mode

.PP
\fB--page-delay\fP=0s
	Wait between paginated --all requests (e.g. 200ms, 1s)

.PP
\fB--plain\fP[=false]
	Output as plain tab-separated text

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-essential output

.PP
\fB--yes\fP[=false]
	Skip confirmation prompts


.SH EXAMPLE
.EX
  gumroad variants update <variant_id> --product <id> --category <cat_id> --file ./license.pdf
.EE


.SH SEE ALSO
\fBgumroad-variants(1)\fP
