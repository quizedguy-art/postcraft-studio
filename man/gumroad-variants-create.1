.nh
.TH "GUMROAD" "1" "Sep 2026" "Gumroad" "Gumroad CLI"

.SH NAME
gumroad-variants-create - Create a variant


.SH SYNOPSIS
\fBgumroad variants create [flags]\fP


.SH DESCRIPTION
Create a variant


.SH OPTIONS
\fB--category\fP=""
	Variant category ID (required)

.PP
\fB--description\fP=""
	Variant description

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for create

.PP
\fB--max-purchase-count\fP=0
	Maximum number of purchases

.PP
\fB--name\fP=""
	Variant name (required)

.PP
\fB--price-difference\fP=""
	Price difference (e.g. 5.00, -1.50)

.PP
\fB--product\fP=""
	Product ID (required)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--debug\fP[=false]
	Enable debug logging to stderr

.PP
\fB--dry-run\fP[=false]
	Preview mutating requests without executing them

.PP
\fB--jq\fP=""
	Filter JSON output with a jq expression

.PP
\fB--json\fP[=false]
	Output as JSON

.PP
\fB--no-color\fP[=false]
	Disable color output

.PP
\fB--no-image\fP[=false]
	Disable image rendering

.PP
\fB--no-input\fP[=false]
	Disable interactive prompts

.PP
\fB--non-interactive\fP[=false]
	Run in explicit CI/agent mode

.PP
\fB--page-delay\fP=0s
	Wait between paginated --all requests (e.g. 200ms, 1s)

.PP
\fB--plain\fP[=false]
	Output as plain tab-separated text

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-essential output

.PP
\fB--yes\fP[=false]
	Skip confirmation prompts


.SH EXAMPLE
.EX
  gumroad variants create --product <id> --category <cat_id> --name "Large"
.EE


.SH SEE ALSO
\fBgumroad-variants(1)\fP
