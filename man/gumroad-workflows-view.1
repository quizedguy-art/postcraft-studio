.nh
.TH "GUMROAD" "1" "Sep 2026" "Gumroad" "Gumroad CLI"

.SH NAME
gumroad-workflows-view - View a workflow and its email steps


.SH SYNOPSIS
\fBgumroad workflows view  [flags]\fP


.SH DESCRIPTION
View a workflow and its email steps, with per-step delay, sent, open, and click stats.

.PP
Plain output prints one row per email step: id, subject, delay, state, sent, opens, open rate, clicks, click rate.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for view


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--debug\fP[=false]
	Enable debug logging to stderr

.PP
\fB--dry-run\fP[=false]
	Preview mutating requests without executing them

.PP
\fB--jq\fP=""
	Filter JSON output with a jq expression

.PP
\fB--json\fP[=false]
	Output as JSON

.PP
\fB--no-color\fP[=false]
	Disable color output

.PP
\fB--no-image\fP[=false]
	Disable image rendering

.PP
\fB--no-input\fP[=false]
	Disable interactive prompts

.PP
\fB--non-interactive\fP[=false]
	Run in explicit CI/agent mode

.PP
\fB--page-delay\fP=0s
	Wait between paginated --all requests (e.g. 200ms, 1s)

.PP
\fB--plain\fP[=false]
	Output as plain tab-separated text

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-essential output

.PP
\fB--yes\fP[=false]
	Skip confirmation prompts


.SH EXAMPLE
.EX
  gumroad workflows view <id>
  gumroad workflows view <id> --json
  gumroad workflows view <id> --plain
.EE


.SH SEE ALSO
\fBgumroad-workflows(1)\fP
