.nh
.TH "GUMROAD" "1" "Sep 2026" "Gumroad" "Gumroad CLI"

.SH NAME
gumroad-products-thumbnail-set - Set a product thumbnail


.SH SYNOPSIS
\fBgumroad products thumbnail set  [flags]\fP


.SH DESCRIPTION
Set a product thumbnail


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for set

.PP
\fB--image\fP=""
	Local JPEG, PNG, or GIF image to upload as the thumbnail

.PP
\fB--url\fP=""
	Remote http(s) image URL to set as the thumbnail


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--debug\fP[=false]
	Enable debug logging to stderr

.PP
\fB--dry-run\fP[=false]
	Preview mutating requests without executing them

.PP
\fB--jq\fP=""
	Filter JSON output with a jq expression

.PP
\fB--json\fP[=false]
	Output as JSON

.PP
\fB--no-color\fP[=false]
	Disable color output

.PP
\fB--no-image\fP[=false]
	Disable image rendering

.PP
\fB--no-input\fP[=false]
	Disable interactive prompts

.PP
\fB--non-interactive\fP[=false]
	Run in explicit CI/agent mode

.PP
\fB--page-delay\fP=0s
	Wait between paginated --all requests (e.g. 200ms, 1s)

.PP
\fB--plain\fP[=false]
	Output as plain tab-separated text

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-essential output

.PP
\fB--yes\fP[=false]
	Skip confirmation prompts


.SH EXAMPLE
.EX
  gumroad products thumbnail set <product_id> --image ./thumb.jpg
  gumroad products thumbnail set <product_id> --url https://example.com/thumb.png
.EE


.SH SEE ALSO
\fBgumroad-products-thumbnail(1)\fP
