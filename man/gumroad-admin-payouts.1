.nh
.TH "GUMROAD" "1" "Sep 2026" "Gumroad" "Gumroad CLI"

.SH NAME
gumroad-admin-payouts - Read and manage admin payout records


.SH SYNOPSIS
\fBgumroad admin payouts [flags]\fP


.SH DESCRIPTION
Read and manage admin payout records


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for payouts


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--debug\fP[=false]
	Enable debug logging to stderr

.PP
\fB--dry-run\fP[=false]
	Preview mutating requests without executing them

.PP
\fB--jq\fP=""
	Filter JSON output with a jq expression

.PP
\fB--json\fP[=false]
	Output as JSON

.PP
\fB--no-color\fP[=false]
	Disable color output

.PP
\fB--no-image\fP[=false]
	Disable image rendering

.PP
\fB--no-input\fP[=false]
	Disable interactive prompts

.PP
\fB--non-interactive\fP[=false]
	Run in explicit CI/agent mode

.PP
\fB--page-delay\fP=0s
	Wait between paginated --all requests (e.g. 200ms, 1s)

.PP
\fB--plain\fP[=false]
	Output as plain tab-separated text

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-essential output

.PP
\fB--yes\fP[=false]
	Skip confirmation prompts


.SH EXAMPLE
.EX
  gumroad admin payouts list --email seller@example.com
  gumroad admin payouts list --user-id 2245593582708
  gumroad admin payouts list --email seller@example.com --json
  gumroad admin payouts pause --user-id 2245593582708 --expected-email seller@example.com --reason "Verification pending"
  gumroad admin payouts resume --user-id 2245593582708
  gumroad admin payouts issue --user-id 2245593582708 --through 2026-04-30 --processor stripe --yes
  gumroad admin payouts scheduled create --user-id 2245593582708 --processor stripe --yes
  gumroad admin payouts scheduled list --status flagged
.EE


.SH SEE ALSO
\fBgumroad-admin(1)\fP, \fBgumroad-admin-payouts-issue(1)\fP, \fBgumroad-admin-payouts-list(1)\fP, \fBgumroad-admin-payouts-pause(1)\fP, \fBgumroad-admin-payouts-resume(1)\fP, \fBgumroad-admin-payouts-scheduled(1)\fP
