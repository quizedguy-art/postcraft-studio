.nh
.TH "GUMROAD" "1" "Sep 2026" "Gumroad" "Gumroad CLI"

.SH NAME
gumroad-licenses - Manage licenses


.SH SYNOPSIS
\fBgumroad licenses [flags]\fP


.SH DESCRIPTION
Manage licenses


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for licenses


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--debug\fP[=false]
	Enable debug logging to stderr

.PP
\fB--dry-run\fP[=false]
	Preview mutating requests without executing them

.PP
\fB--jq\fP=""
	Filter JSON output with a jq expression

.PP
\fB--json\fP[=false]
	Output as JSON

.PP
\fB--no-color\fP[=false]
	Disable color output

.PP
\fB--no-image\fP[=false]
	Disable image rendering

.PP
\fB--no-input\fP[=false]
	Disable interactive prompts

.PP
\fB--non-interactive\fP[=false]
	Run in explicit CI/agent mode

.PP
\fB--page-delay\fP=0s
	Wait between paginated --all requests (e.g. 200ms, 1s)

.PP
\fB--plain\fP[=false]
	Output as plain tab-separated text

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-essential output

.PP
\fB--yes\fP[=false]
	Skip confirmation prompts


.SH EXAMPLE
.EX
  echo "$LICENSE_KEY" | gumroad licenses verify --product <id> --no-increment
  echo "$LICENSE_KEY" | gumroad licenses enable --product <id>
  echo "$LICENSE_KEY" | gumroad licenses disable --product <id>
.EE


.SH SEE ALSO
\fBgumroad(1)\fP, \fBgumroad-licenses-decrement(1)\fP, \fBgumroad-licenses-disable(1)\fP, \fBgumroad-licenses-enable(1)\fP, \fBgumroad-licenses-rotate(1)\fP, \fBgumroad-licenses-verify(1)\fP
