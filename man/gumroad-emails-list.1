.nh
.TH "GUMROAD" "1" "Sep 2026" "Gumroad" "Gumroad CLI"

.SH NAME
gumroad-emails-list - List audience emails


.SH SYNOPSIS
\fBgumroad emails list [flags]\fP


.SH DESCRIPTION
List audience emails by draft, scheduled, or published state.


.SH OPTIONS
\fB--all\fP[=false]
	Fetch all pages

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for list

.PP
\fB--page-key\fP=""
	Pagination cursor

.PP
\fB--state\fP=""
	Filter by state: published, scheduled, draft


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--debug\fP[=false]
	Enable debug logging to stderr

.PP
\fB--dry-run\fP[=false]
	Preview mutating requests without executing them

.PP
\fB--jq\fP=""
	Filter JSON output with a jq expression

.PP
\fB--json\fP[=false]
	Output as JSON

.PP
\fB--no-color\fP[=false]
	Disable color output

.PP
\fB--no-image\fP[=false]
	Disable image rendering

.PP
\fB--no-input\fP[=false]
	Disable interactive prompts

.PP
\fB--non-interactive\fP[=false]
	Run in explicit CI/agent mode

.PP
\fB--page-delay\fP=0s
	Wait between paginated --all requests (e.g. 200ms, 1s)

.PP
\fB--plain\fP[=false]
	Output as plain tab-separated text

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-essential output

.PP
\fB--yes\fP[=false]
	Skip confirmation prompts


.SH EXAMPLE
.EX
  gumroad emails list
  gumroad emails list --state draft
  gumroad emails list --state published --all
  gumroad emails list --json --jq '.emails[0].id'
.EE


.SH SEE ALSO
\fBgumroad-emails(1)\fP
