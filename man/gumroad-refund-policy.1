.nh
.TH "GUMROAD" "1" "Sep 2026" "Gumroad" "Gumroad CLI"

.SH NAME
gumroad-refund-policy - View and update the account refund policy


.SH SYNOPSIS
\fBgumroad refund-policy [flags]\fP


.SH DESCRIPTION
View and update the account-level refund policy shown to buyers.

.PP
Refund policy is store-wide. Allowed refund periods are none, 7, 14, 30, and 183 days.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for refund-policy


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--debug\fP[=false]
	Enable debug logging to stderr

.PP
\fB--dry-run\fP[=false]
	Preview mutating requests without executing them

.PP
\fB--jq\fP=""
	Filter JSON output with a jq expression

.PP
\fB--json\fP[=false]
	Output as JSON

.PP
\fB--no-color\fP[=false]
	Disable color output

.PP
\fB--no-image\fP[=false]
	Disable image rendering

.PP
\fB--no-input\fP[=false]
	Disable interactive prompts

.PP
\fB--non-interactive\fP[=false]
	Run in explicit CI/agent mode

.PP
\fB--page-delay\fP=0s
	Wait between paginated --all requests (e.g. 200ms, 1s)

.PP
\fB--plain\fP[=false]
	Output as plain tab-separated text

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-essential output

.PP
\fB--yes\fP[=false]
	Skip confirmation prompts


.SH EXAMPLE
.EX
  gumroad refund-policy view
  gumroad refund-policy view --json --jq '.refund_policy.refund_period'
  gumroad refund-policy set --period 30 --fine-print "Refund requests are reviewed within 2 business days."
  gumroad refund-policy set --period none --fine-print ""
.EE


.SH SEE ALSO
\fBgumroad(1)\fP, \fBgumroad-refund-policy-set(1)\fP, \fBgumroad-refund-policy-view(1)\fP
