.nh
.TH "GUMROAD" "1" "Sep 2026" "Gumroad" "Gumroad CLI"

.SH NAME
gumroad-pages-create - Create a storefront page


.SH SYNOPSIS
\fBgumroad pages create [path] [flags]\fP


.SH DESCRIPTION
Create a storefront page. Without a path the page starts empty (edit it in the dashboard); with an HTML file (or \fB-\fR for stdin) it is created as a custom HTML page.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for create

.PP
\fB--slug\fP=""
	URL slug (defaults to a slug generated from the title)

.PP
\fB--title\fP=""
	Page title (required)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--debug\fP[=false]
	Enable debug logging to stderr

.PP
\fB--dry-run\fP[=false]
	Preview mutating requests without executing them

.PP
\fB--jq\fP=""
	Filter JSON output with a jq expression

.PP
\fB--json\fP[=false]
	Output as JSON

.PP
\fB--no-color\fP[=false]
	Disable color output

.PP
\fB--no-image\fP[=false]
	Disable image rendering

.PP
\fB--no-input\fP[=false]
	Disable interactive prompts

.PP
\fB--non-interactive\fP[=false]
	Run in explicit CI/agent mode

.PP
\fB--page-delay\fP=0s
	Wait between paginated --all requests (e.g. 200ms, 1s)

.PP
\fB--plain\fP[=false]
	Output as plain tab-separated text

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-essential output

.PP
\fB--yes\fP[=false]
	Skip confirmation prompts


.SH EXAMPLE
.EX
  gumroad pages create --title "About"
  gumroad pages create --title "About" --slug about
  gumroad pages create --title "About" ./about.html
  gumroad pages create --title "About" - < about.html
.EE


.SH SEE ALSO
\fBgumroad-pages(1)\fP
