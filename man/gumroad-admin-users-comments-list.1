.nh
.TH "GUMROAD" "1" "Sep 2026" "Gumroad" "Gumroad CLI"

.SH NAME
gumroad-admin-users-comments-list - List admin comments for a user


.SH SYNOPSIS
\fBgumroad admin users comments list [flags]\fP


.SH DESCRIPTION
List admin comments for a user


.SH OPTIONS
\fB--cursor\fP=""
	Pagination cursor (from a previous response)

.PP
\fB--email\fP=""
	User email

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for list

.PP
\fB--limit\fP=0
	Maximum results per page (default 20)

.PP
\fB--type\fP=[]
	Comment type filter (repeatable)

.PP
\fB--user-id\fP=""
	User external ID

.PP
\fB--username\fP=""
	User username


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--debug\fP[=false]
	Enable debug logging to stderr

.PP
\fB--dry-run\fP[=false]
	Preview mutating requests without executing them

.PP
\fB--jq\fP=""
	Filter JSON output with a jq expression

.PP
\fB--json\fP[=false]
	Output as JSON

.PP
\fB--no-color\fP[=false]
	Disable color output

.PP
\fB--no-image\fP[=false]
	Disable image rendering

.PP
\fB--no-input\fP[=false]
	Disable interactive prompts

.PP
\fB--non-interactive\fP[=false]
	Run in explicit CI/agent mode

.PP
\fB--page-delay\fP=0s
	Wait between paginated --all requests (e.g. 200ms, 1s)

.PP
\fB--plain\fP[=false]
	Output as plain tab-separated text

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-essential output

.PP
\fB--yes\fP[=false]
	Skip confirmation prompts


.SH EXAMPLE
.EX
  gumroad admin users comments list --user-id 2245593582708
  gumroad admin users comments list --username sellerone --type note
  gumroad admin users comments list --email user@example.com --type note --type suspension_note --limit 50
  gumroad admin users comments list --email user@example.com --cursor cur-next
.EE


.SH SEE ALSO
\fBgumroad-admin-users-comments(1)\fP
