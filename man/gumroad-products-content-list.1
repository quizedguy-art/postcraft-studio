.nh
.TH "GUMROAD" "1" "Sep 2026" "Gumroad" "Gumroad CLI"

.SH NAME
gumroad-products-content-list - List product rich content pages


.SH SYNOPSIS
\fBgumroad products content list  [flags]\fP


.SH DESCRIPTION
List product rich content pages.

.PP
Shows page metadata only: id, title, position, and top-level block count. It does not interpret rich content block types.


.SH OPTIONS
\fB--category\fP=""
	Variant category ID for per-variant content

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for list

.PP
\fB--variant\fP=""
	Variant ID for per-variant content


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--debug\fP[=false]
	Enable debug logging to stderr

.PP
\fB--dry-run\fP[=false]
	Preview mutating requests without executing them

.PP
\fB--jq\fP=""
	Filter JSON output with a jq expression

.PP
\fB--json\fP[=false]
	Output as JSON

.PP
\fB--no-color\fP[=false]
	Disable color output

.PP
\fB--no-image\fP[=false]
	Disable image rendering

.PP
\fB--no-input\fP[=false]
	Disable interactive prompts

.PP
\fB--non-interactive\fP[=false]
	Run in explicit CI/agent mode

.PP
\fB--page-delay\fP=0s
	Wait between paginated --all requests (e.g. 200ms, 1s)

.PP
\fB--plain\fP[=false]
	Output as plain tab-separated text

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-essential output

.PP
\fB--yes\fP[=false]
	Skip confirmation prompts


.SH EXAMPLE
.EX
  gumroad products content list <product_id>
  gumroad products content list <product_id> --variant <variant_id> --category <cat_id>
  gumroad products content list <product_id> --json --jq '.[].id'
.EE


.SH SEE ALSO
\fBgumroad-products-content(1)\fP
