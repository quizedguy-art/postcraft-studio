.nh
.TH "GUMROAD" "1" "Sep 2026" "Gumroad" "Gumroad CLI"

.SH NAME
gumroad-user-update - Update your seller name and bio


.SH SYNOPSIS
\fBgumroad user update [flags]\fP


.SH DESCRIPTION
Update the seller name and bio shown on your profile.

.PP
Pass --name and/or --bio. Pass an empty value to clear a field.


.SH OPTIONS
\fB--bio\fP=""
	Seller bio; pass an empty value to clear it

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for update

.PP
\fB--name\fP=""
	Seller name; pass an empty value to clear it


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--debug\fP[=false]
	Enable debug logging to stderr

.PP
\fB--dry-run\fP[=false]
	Preview mutating requests without executing them

.PP
\fB--jq\fP=""
	Filter JSON output with a jq expression

.PP
\fB--json\fP[=false]
	Output as JSON

.PP
\fB--no-color\fP[=false]
	Disable color output

.PP
\fB--no-image\fP[=false]
	Disable image rendering

.PP
\fB--no-input\fP[=false]
	Disable interactive prompts

.PP
\fB--non-interactive\fP[=false]
	Run in explicit CI/agent mode

.PP
\fB--page-delay\fP=0s
	Wait between paginated --all requests (e.g. 200ms, 1s)

.PP
\fB--plain\fP[=false]
	Output as plain tab-separated text

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-essential output

.PP
\fB--yes\fP[=false]
	Skip confirmation prompts


.SH EXAMPLE
.EX
  gumroad user update --name "Jane Doe"
  gumroad user update --bio "I make great things."
  gumroad user update --name "Jane Doe" --bio "I make great things."
.EE


.SH SEE ALSO
\fBgumroad-user(1)\fP
