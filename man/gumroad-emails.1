.nh
.TH "GUMROAD" "1" "Sep 2026" "Gumroad" "Gumroad CLI"

.SH NAME
gumroad-emails - Manage audience emails


.SH SYNOPSIS
\fBgumroad emails [flags]\fP


.SH DESCRIPTION
Manage Gumroad audience emails.

.PP
Draft, preview, send, schedule, unschedule, list, view, and delete broadcast emails. New emails are created as drafts by default; use \fBgumroad emails send-preview <id>\fR to review the preview URL before \fBgumroad emails send <id>\fR\&.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for emails


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--debug\fP[=false]
	Enable debug logging to stderr

.PP
\fB--dry-run\fP[=false]
	Preview mutating requests without executing them

.PP
\fB--jq\fP=""
	Filter JSON output with a jq expression

.PP
\fB--json\fP[=false]
	Output as JSON

.PP
\fB--no-color\fP[=false]
	Disable color output

.PP
\fB--no-image\fP[=false]
	Disable image rendering

.PP
\fB--no-input\fP[=false]
	Disable interactive prompts

.PP
\fB--non-interactive\fP[=false]
	Run in explicit CI/agent mode

.PP
\fB--page-delay\fP=0s
	Wait between paginated --all requests (e.g. 200ms, 1s)

.PP
\fB--plain\fP[=false]
	Output as plain tab-separated text

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-essential output

.PP
\fB--yes\fP[=false]
	Skip confirmation prompts


.SH EXAMPLE
.EX
  gumroad emails create --subject "New release" --body ./email.html
  gumroad emails create --subject "Product update" --body ./email.html --audience product --product <id>
  gumroad emails send-preview <id>
  gumroad emails schedule <id> --at "2026-06-18T14:00:00Z"
  gumroad emails unschedule <id>
  gumroad emails list --state draft --json
  gumroad emails view <id>
  gumroad emails send <id> --yes
  gumroad emails delete <id> --yes
.EE


.SH SEE ALSO
\fBgumroad(1)\fP, \fBgumroad-emails-create(1)\fP, \fBgumroad-emails-delete(1)\fP, \fBgumroad-emails-list(1)\fP, \fBgumroad-emails-schedule(1)\fP, \fBgumroad-emails-send(1)\fP, \fBgumroad-emails-send-preview(1)\fP, \fBgumroad-emails-unschedule(1)\fP, \fBgumroad-emails-view(1)\fP
