.nh
.TH "GUMROAD" "1" "Sep 2026" "Gumroad" "Gumroad CLI"

.SH NAME
gumroad-auth-login - Log in to Gumroad


.SH SYNOPSIS
\fBgumroad auth login [flags]\fP


.SH DESCRIPTION
Log in to Gumroad via OAuth device authorization or a manual API token.

.PP
By default, starts device authorization and waits for approval.
Use --web to force the local browser OAuth flow.
Use --with-token to read an existing seller token from stdin.
Piped stdin without --with-token is still accepted for compatibility.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for login

.PP
\fB--web\fP[=false]
	Force browser-based OAuth login

.PP
\fB--with-token\fP[=false]
	Read an existing seller token from stdin


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--debug\fP[=false]
	Enable debug logging to stderr

.PP
\fB--dry-run\fP[=false]
	Preview mutating requests without executing them

.PP
\fB--jq\fP=""
	Filter JSON output with a jq expression

.PP
\fB--json\fP[=false]
	Output as JSON

.PP
\fB--no-color\fP[=false]
	Disable color output

.PP
\fB--no-image\fP[=false]
	Disable image rendering

.PP
\fB--no-input\fP[=false]
	Disable interactive prompts

.PP
\fB--non-interactive\fP[=false]
	Run in explicit CI/agent mode

.PP
\fB--page-delay\fP=0s
	Wait between paginated --all requests (e.g. 200ms, 1s)

.PP
\fB--plain\fP[=false]
	Output as plain tab-separated text

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-essential output

.PP
\fB--yes\fP[=false]
	Skip confirmation prompts


.SH EXAMPLE
.EX
  # Device authorization login (default)
  gumroad auth login

  # Local browser OAuth
  gumroad auth login --web

  # Store an existing token from stdin (CI/scripts)
  gumroad auth login --with-token < token.txt
  printf '%s\\n' "$GUMROAD_ACCESS_TOKEN" | gumroad auth login --with-token
.EE


.SH SEE ALSO
\fBgumroad-auth(1)\fP
