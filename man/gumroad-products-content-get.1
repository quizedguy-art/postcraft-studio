.nh
.TH "GUMROAD" "1" "Sep 2026" "Gumroad" "Gumroad CLI"

.SH NAME
gumroad-products-content-get - Dump product rich content JSON


.SH SYNOPSIS
\fBgumroad products content get  [flags]\fP


.SH DESCRIPTION
Dump a product's rich content page array as JSON.

.PP
The output is a JSON document intended for editing and passing back to \fBgumroad products content set\fR\&. Pass \fB--page\fR to dump one page object. Use \fB--jq\fR to filter it.


.SH OPTIONS
\fB--category\fP=""
	Variant category ID for per-variant content

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for get

.PP
\fB--page\fP=""
	Rich content page ID to dump

.PP
\fB--variant\fP=""
	Variant ID for per-variant content


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--debug\fP[=false]
	Enable debug logging to stderr

.PP
\fB--dry-run\fP[=false]
	Preview mutating requests without executing them

.PP
\fB--jq\fP=""
	Filter JSON output with a jq expression

.PP
\fB--json\fP[=false]
	Output as JSON

.PP
\fB--no-color\fP[=false]
	Disable color output

.PP
\fB--no-image\fP[=false]
	Disable image rendering

.PP
\fB--no-input\fP[=false]
	Disable interactive prompts

.PP
\fB--non-interactive\fP[=false]
	Run in explicit CI/agent mode

.PP
\fB--page-delay\fP=0s
	Wait between paginated --all requests (e.g. 200ms, 1s)

.PP
\fB--plain\fP[=false]
	Output as plain tab-separated text

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-essential output

.PP
\fB--yes\fP[=false]
	Skip confirmation prompts


.SH EXAMPLE
.EX
  gumroad products content get <product_id> > content.json
  gumroad products content get <product_id> --variant <variant_id> --category <cat_id> > content.json
  gumroad products content get <product_id> --page <page_id> > page.json
  gumroad products content get <product_id> --jq '.[].id'
.EE


.SH SEE ALSO
\fBgumroad-products-content(1)\fP
