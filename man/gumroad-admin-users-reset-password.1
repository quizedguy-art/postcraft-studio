.nh
.TH "GUMROAD" "1" "Sep 2026" "Gumroad" "Gumroad CLI"

.SH NAME
gumroad-admin-users-reset-password - Send password reset instructions to a user


.SH SYNOPSIS
\fBgumroad admin users reset-password [flags]\fP


.SH DESCRIPTION
Send Devise password reset instructions to a user. The email is delivered
to the address currently on file for the user, not to the admin.

.PP
Identify the user with --user-id. Pass --expected-email as an optional guard
against acting on an account whose email has changed.


.SH OPTIONS
\fB--expected-email\fP=""
	Optional current email guard

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for reset-password

.PP
\fB--user-id\fP=""
	User external ID (required)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--debug\fP[=false]
	Enable debug logging to stderr

.PP
\fB--dry-run\fP[=false]
	Preview mutating requests without executing them

.PP
\fB--jq\fP=""
	Filter JSON output with a jq expression

.PP
\fB--json\fP[=false]
	Output as JSON

.PP
\fB--no-color\fP[=false]
	Disable color output

.PP
\fB--no-image\fP[=false]
	Disable image rendering

.PP
\fB--no-input\fP[=false]
	Disable interactive prompts

.PP
\fB--non-interactive\fP[=false]
	Run in explicit CI/agent mode

.PP
\fB--page-delay\fP=0s
	Wait between paginated --all requests (e.g. 200ms, 1s)

.PP
\fB--plain\fP[=false]
	Output as plain tab-separated text

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-essential output

.PP
\fB--yes\fP[=false]
	Skip confirmation prompts


.SH EXAMPLE
.EX
  gumroad admin users reset-password --user-id 2245593582708
  gumroad admin users reset-password --user-id 2245593582708 --expected-email user@example.com
  gumroad admin users reset-password --user-id 2245593582708 --yes
.EE


.SH SEE ALSO
\fBgumroad-admin-users(1)\fP
