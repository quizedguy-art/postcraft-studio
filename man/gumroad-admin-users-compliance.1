.nh
.TH "GUMROAD" "1" "Sep 2026" "Gumroad" "Gumroad CLI"

.SH NAME
gumroad-admin-users-compliance - View a user's submitted compliance info


.SH SYNOPSIS
\fBgumroad admin users compliance [flags]\fP


.SH DESCRIPTION
View a user's submitted KYC data and open compliance info requests.

.PP
Identify the user with --email, --user-id, or --username. When more than one
is supplied, the server resolves by --user-id first, then --email, then
--username.


.SH OPTIONS
\fB--email\fP=""
	User email

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for compliance

.PP
\fB--user-id\fP=""
	User external ID

.PP
\fB--username\fP=""
	User username


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--debug\fP[=false]
	Enable debug logging to stderr

.PP
\fB--dry-run\fP[=false]
	Preview mutating requests without executing them

.PP
\fB--jq\fP=""
	Filter JSON output with a jq expression

.PP
\fB--json\fP[=false]
	Output as JSON

.PP
\fB--no-color\fP[=false]
	Disable color output

.PP
\fB--no-image\fP[=false]
	Disable image rendering

.PP
\fB--no-input\fP[=false]
	Disable interactive prompts

.PP
\fB--non-interactive\fP[=false]
	Run in explicit CI/agent mode

.PP
\fB--page-delay\fP=0s
	Wait between paginated --all requests (e.g. 200ms, 1s)

.PP
\fB--plain\fP[=false]
	Output as plain tab-separated text

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-essential output

.PP
\fB--yes\fP[=false]
	Skip confirmation prompts


.SH EXAMPLE
.EX
  gumroad admin users compliance --user-id 2245593582708
  gumroad admin users compliance --username sellerone
  gumroad admin users compliance --email user@example.com --json
.EE


.SH SEE ALSO
\fBgumroad-admin-users(1)\fP
