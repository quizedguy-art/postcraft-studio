.nh
.TH "GUMROAD" "1" "Sep 2026" "Gumroad" "Gumroad CLI"

.SH NAME
gumroad-licenses-verify - Verify a license key


.SH SYNOPSIS
\fBgumroad licenses verify [flags]\fP


.SH DESCRIPTION
Verify a license key for a product.

.PP
WARNING: By default, this increments the license use count.
Use --no-increment to verify without incrementing.

.PP
Provide the key via stdin or the interactive prompt when possible. --key remains for compatibility.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for verify

.PP
\fB--key\fP=""
	License key (deprecated; prefer stdin or interactive prompt)

.PP
\fB--no-increment\fP[=false]
	Verify without incrementing use count

.PP
\fB--product\fP=""
	Product ID (required)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--debug\fP[=false]
	Enable debug logging to stderr

.PP
\fB--dry-run\fP[=false]
	Preview mutating requests without executing them

.PP
\fB--jq\fP=""
	Filter JSON output with a jq expression

.PP
\fB--json\fP[=false]
	Output as JSON

.PP
\fB--no-color\fP[=false]
	Disable color output

.PP
\fB--no-image\fP[=false]
	Disable image rendering

.PP
\fB--no-input\fP[=false]
	Disable interactive prompts

.PP
\fB--non-interactive\fP[=false]
	Run in explicit CI/agent mode

.PP
\fB--page-delay\fP=0s
	Wait between paginated --all requests (e.g. 200ms, 1s)

.PP
\fB--plain\fP[=false]
	Output as plain tab-separated text

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-essential output

.PP
\fB--yes\fP[=false]
	Skip confirmation prompts


.SH EXAMPLE
.EX
  gumroad licenses verify --product <value>
.EE


.SH SEE ALSO
\fBgumroad-licenses(1)\fP
