.nh
.TH "GUMROAD" "1" "Sep 2026" "Gumroad" "Gumroad CLI"

.SH NAME
gumroad-admin-payouts-scheduled-create - Create a delayed scheduled payout for a suspended user


.SH SYNOPSIS
\fBgumroad admin payouts scheduled create [flags]\fP


.SH DESCRIPTION
Create a ScheduledPayout row for a suspended user with unpaid balance.

.PP
The server defaults --payout-date to 21 days from the current UTC date. Pass a
YYYY-MM-DD date to schedule a specific UTC payout date. --processor is required
and must be stripe or paypal.

.PP
This schedules money movement. --yes is required.


.SH OPTIONS
\fB--expected-email\fP=""
	Optional current email guard

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for create

.PP
\fB--note\fP=""
	Optional payout note recorded on the user

.PP
\fB--payout-date\fP=""
	UTC payout date in YYYY-MM-DD (defaults server-side to today + 21 days)

.PP
\fB--processor\fP=""
	Payout processor: stripe or paypal (required)

.PP
\fB--user-id\fP=""
	User external ID (required)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--debug\fP[=false]
	Enable debug logging to stderr

.PP
\fB--dry-run\fP[=false]
	Preview mutating requests without executing them

.PP
\fB--jq\fP=""
	Filter JSON output with a jq expression

.PP
\fB--json\fP[=false]
	Output as JSON

.PP
\fB--no-color\fP[=false]
	Disable color output

.PP
\fB--no-image\fP[=false]
	Disable image rendering

.PP
\fB--no-input\fP[=false]
	Disable interactive prompts

.PP
\fB--non-interactive\fP[=false]
	Run in explicit CI/agent mode

.PP
\fB--page-delay\fP=0s
	Wait between paginated --all requests (e.g. 200ms, 1s)

.PP
\fB--plain\fP[=false]
	Output as plain tab-separated text

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-essential output

.PP
\fB--yes\fP[=false]
	Skip confirmation prompts


.SH EXAMPLE
.EX
  gumroad admin payouts scheduled create --user-id 2245593582708 --processor stripe --yes
  gumroad admin payouts scheduled create --user-id 2245593582708 --expected-email seller@example.com --processor paypal --payout-date 2026-06-15 --note "Appeal window closes before payout." --yes
.EE


.SH SEE ALSO
\fBgumroad-admin-payouts-scheduled(1)\fP
