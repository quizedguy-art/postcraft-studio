.nh
.TH "GUMROAD" "1" "Sep 2026" "Gumroad" "Gumroad CLI"

.SH NAME
gumroad-products-content - Manage product rich content


.SH SYNOPSIS
\fBgumroad products content [flags]\fP


.SH DESCRIPTION
Manage product rich content.

.PP
Get or replace the whole rich content document for products that use shared content or per-variant content.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for content


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--debug\fP[=false]
	Enable debug logging to stderr

.PP
\fB--dry-run\fP[=false]
	Preview mutating requests without executing them

.PP
\fB--jq\fP=""
	Filter JSON output with a jq expression

.PP
\fB--json\fP[=false]
	Output as JSON

.PP
\fB--no-color\fP[=false]
	Disable color output

.PP
\fB--no-image\fP[=false]
	Disable image rendering

.PP
\fB--no-input\fP[=false]
	Disable interactive prompts

.PP
\fB--non-interactive\fP[=false]
	Run in explicit CI/agent mode

.PP
\fB--page-delay\fP=0s
	Wait between paginated --all requests (e.g. 200ms, 1s)

.PP
\fB--plain\fP[=false]
	Output as plain tab-separated text

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-essential output

.PP
\fB--yes\fP[=false]
	Skip confirmation prompts


.SH EXAMPLE
.EX
  gumroad products content get <product_id> > content.json
  gumroad products content get <product_id> --variant <variant_id> --category <cat_id> > content.json
  gumroad products content get <product_id> --page <page_id> > page.json
  gumroad products content list <product_id>
  gumroad products content set <product_id> content.json --dry-run
  gumroad products content set <product_id> --page <page_id> --dry-run
  gumroad products content set <product_id> page.json --page <page_id> --dry-run
  gumroad products content set <product_id> content.json --variant <variant_id> --category <cat_id> --dry-run
  gumroad products content set <product_id> content.json --yes
  gumroad products content set <product_id> - < content.json
.EE


.SH SEE ALSO
\fBgumroad-products(1)\fP, \fBgumroad-products-content-get(1)\fP, \fBgumroad-products-content-list(1)\fP, \fBgumroad-products-content-set(1)\fP
