.nh
.TH "GUMROAD" "1" "Sep 2026" "Gumroad" "Gumroad CLI"

.SH NAME
gumroad-sales-summary - Show aggregated sales totals


.SH SYNOPSIS
\fBgumroad sales summary [flags]\fP


.SH DESCRIPTION
Show aggregated sales totals


.SH OPTIONS
\fB--from\fP=""
	Summarize sales from date (YYYY-MM-DD)

.PP
\fB--group-by\fP=""
	Group breakdown by product, day, week, or month

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for summary

.PP
\fB--to\fP=""
	Summarize sales to date (YYYY-MM-DD)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--debug\fP[=false]
	Enable debug logging to stderr

.PP
\fB--dry-run\fP[=false]
	Preview mutating requests without executing them

.PP
\fB--jq\fP=""
	Filter JSON output with a jq expression

.PP
\fB--json\fP[=false]
	Output as JSON

.PP
\fB--no-color\fP[=false]
	Disable color output

.PP
\fB--no-image\fP[=false]
	Disable image rendering

.PP
\fB--no-input\fP[=false]
	Disable interactive prompts

.PP
\fB--non-interactive\fP[=false]
	Run in explicit CI/agent mode

.PP
\fB--page-delay\fP=0s
	Wait between paginated --all requests (e.g. 200ms, 1s)

.PP
\fB--plain\fP[=false]
	Output as plain tab-separated text

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-essential output

.PP
\fB--yes\fP[=false]
	Skip confirmation prompts


.SH EXAMPLE
.EX
  gumroad sales summary
  gumroad sales summary --from 2026-01-01 --to 2026-05-21
  gumroad sales summary --group-by product
  gumroad sales summary --group-by month --from 2025-05-21
.EE


.SH SEE ALSO
\fBgumroad-sales(1)\fP
