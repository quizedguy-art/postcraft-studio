.nh
.TH "GUMROAD" "1" "Sep 2026" "Gumroad" "Gumroad CLI"

.SH NAME
gumroad-admin-purchases-search - Search admin purchases by buyer email


.SH SYNOPSIS
\fBgumroad admin purchases search [flags]\fP


.SH DESCRIPTION
Search admin purchases by buyer email. Results are capped server-side
(currently 25). The server endpoint also supports query, purchase_status,
creator_email, license_key, and several card filters; this command
exposes only --email and --limit for now.


.SH OPTIONS
\fB--email\fP=""
	Buyer email (required)

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for search

.PP
\fB--limit\fP=0
	Maximum results to return (server caps at 25)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--debug\fP[=false]
	Enable debug logging to stderr

.PP
\fB--dry-run\fP[=false]
	Preview mutating requests without executing them

.PP
\fB--jq\fP=""
	Filter JSON output with a jq expression

.PP
\fB--json\fP[=false]
	Output as JSON

.PP
\fB--no-color\fP[=false]
	Disable color output

.PP
\fB--no-image\fP[=false]
	Disable image rendering

.PP
\fB--no-input\fP[=false]
	Disable interactive prompts

.PP
\fB--non-interactive\fP[=false]
	Run in explicit CI/agent mode

.PP
\fB--page-delay\fP=0s
	Wait between paginated --all requests (e.g. 200ms, 1s)

.PP
\fB--plain\fP[=false]
	Output as plain tab-separated text

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-essential output

.PP
\fB--yes\fP[=false]
	Skip confirmation prompts


.SH EXAMPLE
.EX
  gumroad admin purchases search --email buyer@example.com
  gumroad admin purchases search --email buyer@example.com --limit 10
  gumroad admin purchases search --email buyer@example.com --json
.EE


.SH SEE ALSO
\fBgumroad-admin-purchases(1)\fP
