.nh
.TH "GUMROAD" "1" "Sep 2026" "Gumroad" "Gumroad CLI"

.SH NAME
gumroad-admin-users-two-factor-disable - Disable two-factor authentication for a user


.SH SYNOPSIS
\fBgumroad admin users two-factor disable [flags]\fP


.SH DESCRIPTION
Disable two-factor authentication for a user. The user's existing TOTP
credential is destroyed; they will lose 2FA on their next login and any
recovery codes they had become invalid.

.PP
Identify the user with --user-id. Pass --expected-email as an optional guard
against acting on an account whose email has changed.


.SH OPTIONS
\fB--expected-email\fP=""
	Optional current email guard

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for disable

.PP
\fB--user-id\fP=""
	User external ID (required)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--debug\fP[=false]
	Enable debug logging to stderr

.PP
\fB--dry-run\fP[=false]
	Preview mutating requests without executing them

.PP
\fB--jq\fP=""
	Filter JSON output with a jq expression

.PP
\fB--json\fP[=false]
	Output as JSON

.PP
\fB--no-color\fP[=false]
	Disable color output

.PP
\fB--no-image\fP[=false]
	Disable image rendering

.PP
\fB--no-input\fP[=false]
	Disable interactive prompts

.PP
\fB--non-interactive\fP[=false]
	Run in explicit CI/agent mode

.PP
\fB--page-delay\fP=0s
	Wait between paginated --all requests (e.g. 200ms, 1s)

.PP
\fB--plain\fP[=false]
	Output as plain tab-separated text

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-essential output

.PP
\fB--yes\fP[=false]
	Skip confirmation prompts


.SH EXAMPLE
.EX
  gumroad admin users two-factor disable --user-id 2245593582708
  gumroad admin users two-factor disable --user-id 2245593582708 --expected-email user@example.com
.EE


.SH SEE ALSO
\fBgumroad-admin-users-two-factor(1)\fP
