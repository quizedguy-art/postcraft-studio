.nh
.TH "GUMROAD" "1" "Sep 2026" "Gumroad" "Gumroad CLI"

.SH NAME
gumroad-admin-products - Read admin product records


.SH SYNOPSIS
\fBgumroad admin products [flags]\fP


.SH DESCRIPTION
Read admin product records


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for products


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--debug\fP[=false]
	Enable debug logging to stderr

.PP
\fB--dry-run\fP[=false]
	Preview mutating requests without executing them

.PP
\fB--jq\fP=""
	Filter JSON output with a jq expression

.PP
\fB--json\fP[=false]
	Output as JSON

.PP
\fB--no-color\fP[=false]
	Disable color output

.PP
\fB--no-image\fP[=false]
	Disable image rendering

.PP
\fB--no-input\fP[=false]
	Disable interactive prompts

.PP
\fB--non-interactive\fP[=false]
	Run in explicit CI/agent mode

.PP
\fB--page-delay\fP=0s
	Wait between paginated --all requests (e.g. 200ms, 1s)

.PP
\fB--plain\fP[=false]
	Output as plain tab-separated text

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-essential output

.PP
\fB--yes\fP[=false]
	Skip confirmation prompts


.SH EXAMPLE
.EX
  gumroad admin products list --email seller@example.com
  gumroad admin products list --external-id 2245593582708
  gumroad admin products list --email seller@example.com --page 2 --per-page 25
  gumroad admin products list --email seller@example.com --json
  gumroad admin products view abc123
  gumroad admin products flag-for-tos-violation abc123 --user-id 2245593582708
.EE


.SH SEE ALSO
\fBgumroad-admin(1)\fP, \fBgumroad-admin-products-files(1)\fP, \fBgumroad-admin-products-flag-for-tos-violation(1)\fP, \fBgumroad-admin-products-list(1)\fP, \fBgumroad-admin-products-view(1)\fP
