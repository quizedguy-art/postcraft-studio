.nh
.TH "GUMROAD" "1" "Sep 2026" "Gumroad" "Gumroad CLI"

.SH NAME
gumroad-offer-codes-create - Create an offer code


.SH SYNOPSIS
\fBgumroad offer-codes create [flags]\fP


.SH DESCRIPTION
Create an offer code for a product.

.PP
Use either --amount (flat discount) or --percent-off (percentage discount), not both.

.PP
Use --minimum-amount to require a minimum order total before the discount applies
(e.g. "spend over $100 to get 10% off").


.SH OPTIONS
\fB--amount\fP=""
	Flat discount amount (e.g. 5, 5.00)

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for create

.PP
\fB--max-purchase-count\fP=0
	Maximum number of uses

.PP
\fB--minimum-amount\fP=""
	Minimum order total required for the discount to apply (e.g. 100, 100.00)

.PP
\fB--name\fP=""
	Offer code name (required)

.PP
\fB--percent-off\fP=0
	Percentage discount

.PP
\fB--product\fP=""
	Product ID (required)

.PP
\fB--universal\fP[=false]
	Universal offer code


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--debug\fP[=false]
	Enable debug logging to stderr

.PP
\fB--dry-run\fP[=false]
	Preview mutating requests without executing them

.PP
\fB--jq\fP=""
	Filter JSON output with a jq expression

.PP
\fB--json\fP[=false]
	Output as JSON

.PP
\fB--no-color\fP[=false]
	Disable color output

.PP
\fB--no-image\fP[=false]
	Disable image rendering

.PP
\fB--no-input\fP[=false]
	Disable interactive prompts

.PP
\fB--non-interactive\fP[=false]
	Run in explicit CI/agent mode

.PP
\fB--page-delay\fP=0s
	Wait between paginated --all requests (e.g. 200ms, 1s)

.PP
\fB--plain\fP[=false]
	Output as plain tab-separated text

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	Suppress non-essential output

.PP
\fB--yes\fP[=false]
	Skip confirmation prompts


.SH EXAMPLE
.EX
  gumroad offer-codes create --product <id> --name SAVE10 --percent-off 10
.EE


.SH SEE ALSO
\fBgumroad-offer-codes(1)\fP
